    "cupRules": {
        "Mountain Cup: Great League Edition": "1,500 CP limit. Only Rock-, Ground-, Ice-, and Steel-types allowed.",
        "Holiday Cup: Great League Edition": "1,500 CP limit. Only Normal-, Grass-, Electric-, Flying-, Ice-, and Ghost-types allowed.",
        "Fighting Cup: Great League Edition": "1,500 CP limit. Only Fighting-types allowed. Flying-, Psychic-, and Ghost-types are banned.",
        "Jungle Cup: Great League Edition": "1,500 CP limit. Only Normal-, Grass-, Electric-, Bug-, Flying-, Poison-, Ground-, and Dark-types allowed.",
        "Love Cup: Great League Edition": "1,500 CP limit. Only Only red- and pink-colored Pokémon allowed.",
        "2027 GO EUIC Cup": "1,500 CP limit. Mega-Evolved Pokémon are allowed. Only Electric-, Rock-, Poison-, Ice-, and Dark-types allowed. Grass-, Ground-, Fighting-, Steel-, and Fairy-types are banned. Nidorina, Grimer, Lanturn, Magcargo, Sableye, Mega Sableye, Pachirisu, Drapion, Crustle, Malamar, Mega Malamar, Dragalge, Charjabug, Minior, Carkol, and Coalossal are banned.",
        "Mega Catch Cup: Great League Edition": "1,500 CP limit. Only Pokémon caught during Daydream Destinations allowed. Mega-Evolved Pokémon are allowed."
